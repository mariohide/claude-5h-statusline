#!/bin/bash
# Claude Code statusLine：常驻显示 5h 滚动窗口的用量与距重置剩余时间。
#
# 数据来自 Claude Code 通过 stdin 传入的 rate_limits.five_hour，
# 无网络请求、无 API key、无后台进程。仅依赖 jq。
#
# 输出形如：  5h 42% · 2h13m
# 百分数按档位着色：<70 薄荷绿 / 70–89 橙 / ≥90 红；剩余时间恒为暗灰。

jq -j '
try (
  (.rate_limits.five_hour // {}) as $f
  | $f.used_percentage as $raw
  # 后端尚未下发配额数据时不渲染——没有数字可显示
  | if $raw == null then empty else
      ($raw | tonumber) as $pct
      # 配色比较用原始值，显示用四舍五入值：89.6 显示 90% 但仍是橙色
      | (if   $pct >= 90 then "[38;2;232;116;116m"
         elif $pct >= 70 then "[38;2;232;168;92m"
         else                 "[38;2;142;224;192m"
         end) as $col
      | $f.resets_at as $r
      | (if ($r == null or $r == 0 or $r == false or $r == "") then ""
         else
           ((($r | tonumber) - now) | floor) as $rem
           | if $rem <= 0 then "now"
             else
               (($rem / 60) | floor) as $tm
               | (($tm / 60) | floor) as $h
               | ($tm % 60) as $m
               | if $h > 0
                 then "\($h)h\(if $m < 10 then "0" else "" end)\($m)m"
                 else "\($m)m"
                 end
             end
         end) as $eta
      | "5h \($col)\($pct | round)%[0m"
        + (if $eta == "" then "" else " [38;2;120;125;132m· \($eta)[0m" end)
    end
) catch empty
' 2>/dev/null || exit 0
